# ============================================================================
# Airflow custom image: python:3.11-slim + project dependencies
# ============================================================================
FROM apache/airflow:2.9.3-python3.11

USER root

# Cai cac thu vien he thong can thiet cho psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Copy requirements va cai project dependencies (khong can pytest trong Airflow)
COPY requirements.txt /tmp/requirements.txt
RUN grep -Ev "pytest" /tmp/requirements.txt | pip install --no-cache-dir -r /dev/stdin

# Copy project code vao Airflow PYTHONPATH
COPY --chown=airflow:root src/ /opt/airflow/src/
COPY --chown=airflow:root config/ /opt/airflow/config/
COPY --chown=airflow:root main.py /opt/airflow/main.py
